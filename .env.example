# --- Database (local docker: `docker compose up -d`) ---
DATABASE_URL=postgres://zapeve:zapeve@localhost:5438/zap_eve
# Neon prod: also set DATABASE_URL_UNPOOLED (direct connection) for migrations.
# DATABASE_URL_UNPOOLED=

# --- Model (the eve runtime calls Anthropic directly) ---
ANTHROPIC_API_KEY=

# --- Secrets (each: openssl rand -hex 32; never reuse across products) ---
# Signs the 7-day Zap session JWTs.
AUTH_JWT_SECRET=
# Encrypts Dhan credentials at rest. Rotating it forces every user to
# reconnect Dhan — pin it per environment and never regenerate.
CREDS_ENCRYPTION_KEY=
# HMAC pepper for one-time login codes.
CREDS_HASH_PEPPER=
# Shared secret between the Next proxy and the eve runtime channel.
EVE_PROXY_SECRET=

# --- Email (login codes). Unset → codes are logged to the server console. ---
# RESEND_API_KEY=
# Must be on a Resend-VERIFIED domain (zap-api uses codeongrass.com; the
# zaptrade.app domain is NOT verified and Resend 403s on it).
# OTP_FROM_EMAIL=Zap Trade <login-link@codeongrass.com>
# OTP_COOLDOWN_SECONDS=30

# --- Production topology (unset locally: withEve serves eve on this origin) ---
# EVE_UPSTREAM_ORIGIN=https://zap-eve-agent-runtime.vercel.app

# --- Local bench fallback ONLY (direct `eve dev` sends with no proxy) ---
# DHAN_ACCESS_TOKEN=
# DHAN_CLIENT_ID=
# DHAN_BENCH_SECURITY_ID=2885
# DHAN_BENCH_EXCHANGE_SEGMENT=NSE_EQ
# DHAN_BENCH_PRODUCT_TYPE=INTRADAY
# DHAN_BENCH_SYMBOL=RELIANCE
